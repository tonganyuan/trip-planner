
# ============ LLM ============
# 服务端不再持有"给所有人用"的模型 Key（避免任何注册用户都能烧站长的额度）。
# 模型由每个家庭在站点「模型设置」页自行填写，加密后存进数据库。
# 下面几项只作历史兼容保留，逻辑上已无人读取，留空即可。
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# ============ 用户认证 ============
# SQLite 数据库位置(相对路径按项目根目录解析)
DB_PATH=data/app.db

# JWT 签名密钥。留空会自动生成并写入 data/.auth_secret
# 线上至少填一串 48 位以上随机字符：openssl rand -base64 48
AUTH_SECRET=

# 令牌有效期(分钟)，默认 7 天
AUTH_TOKEN_EXPIRE_MINUTES=10080

# 是否开放注册。单人使用建议改成 false，之后只保留自己的账号
ALLOW_REGISTER=true