{
  "name": "helloagents-trip-planner-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "build:android": "vue-tsc && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
