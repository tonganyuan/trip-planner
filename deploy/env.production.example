# ============================================================
# trip-planner 生产环境配置模板
# 部署时复制为 .env：cp env.production.example /opt/trip-planner/.env
# 然后 chmod 640 .env，填入真实密钥，最后 systemctl restart trip-planner
# 注意：改完 .env 必须重启服务，uvicorn --reload 不监视 .env
# ============================================================

# ---------- LLM（DeepSeek，OpenAI 兼容协议） ----------
LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
# 生成一份完整计划常需 60~120 秒，留足余量
LLM_TIMEOUT=180

# ---------- 服务监听（仅本机，对外由 nginx 反代） ----------
HOST=127.0.0.1
PORT=8000

# ---------- CORS ----------
# 前端与后端同源（都经 nginx 80/443），浏览器不会触发跨域，这里只为直连 8000 调试保留
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- Unsplash（景点配图） ----------
UNSPLASH_ACCESS_KEY=REPLACE_ME
UNSPLASH_SECRET_KEY=REPLACE_ME
UNSPLASH_BASE_URL=https://api.unsplash.com

# ---------- 高德地图（服务端 MCP 用） ----------
AMAP_API_KEY=REPLACE_ME

# ---------- 用户认证 ----------
# 账号库放运行用户的家目录：/opt/trip-planner 每次部署都会被 chown 成 root，
# 放那里 www-data 写不进去，首次建表就会 Permission denied
DB_PATH=/var/lib/trip-planner/data/app.db
# 留空则自动生成 48 字节随机密钥并落盘到 DB_PATH 同目录的 .auth_secret
# 想让所有设备强制重新登录时，换掉这个值并重启服务即可
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=10080
# 第一个账号注册完成后建议改成 false，避免陌生人注册
ALLOW_REGISTER=true
